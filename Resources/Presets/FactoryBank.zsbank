[Acid Line]
category = Sequence
comment = Hold one key: a 16-step acid pattern with accents and slides. Mod wheel opens the filter.
seq.mode = Note
seq.div = 1/16
seq.len = 16
seq.gate = 0.55
seq.s1.val = 0
seq.s1.acc = on
seq.s2.val = 0
seq.s3.val = 1
seq.s3.slide = on
seq.s4.val = 0
seq.s5.val = 0.25
seq.s5.acc = on
seq.s6.gate = off
seq.s7.val = 0
seq.s8.val = 0.5833
seq.s8.slide = on
seq.s9.val = 0.5
seq.s10.val = 0
seq.s10.acc = on
seq.s11.val = 0.25
seq.s12.gate = off
seq.s13.val = 0.8333
seq.s13.slide = on
seq.s14.val = 1
seq.s15.val = 0
seq.s15.acc = on
seq.s16.val = 0.25
osc1.wave = Saw
osc1.octave = 16'
flt.cutoff = 380
flt.res = 0.78
flt.env = 0.45
flt.vel = 0.4
flt.key = 0.3
env2.d = 0.18
env2.s = 0
env2.vel = 0.7
env1.s = 0.9
env1.r = 0.03
mix.drive = 0.4
fx.drive.on = on
fx.drive.amt = 0.25
fx.drive.mix = 0.6
fx.dly.on = on
fx.dly.div = 1/8D
fx.dly.mix = 0.18
fx.dly.fb = 0.35
mod1.src = Mod Wheel
mod1.dst = Cutoff
mod1.amt = 0.3
amp.level = 1.000

