# =============================================================================
#  ZYNTH factory bank — original sounds, format version 1.
#
#  Each preset starts from the INIT patch; only the lines given change it.
#  Keys are parameter ids (see docs/PRESET_FORMAT.md), values are real units,
#  choice labels, or on/off. "inherit = <name>" copies an earlier preset first.
#  Edit freely: the bank is embedded at build time and validated by the tests.
# =============================================================================

# ------------------------------------------------------------------ BASS ----

[Classic Saw Bass]
category = Bass
comment = Two detuned saws one octave down through the ladder, quick filter decay.
voice.mode = Legato
voice.glide = 0.04
voice.glidemode = Legato
osc1.octave = 16'
osc2.on = on
osc2.octave = 16'
osc2.fine = 7
osc3.on = on
osc3.wave = Square
osc3.octave = 32'
osc3.level = 0.5
flt.cutoff = 260
flt.res = 0.3
flt.env = 0.42
flt.key = 0.4
flt.vel = 0.15
env2.a = 0.001
env2.d = 0.32
env2.s = 0.18
env2.r = 0.15
env1.d = 0.6
env1.s = 0.9
env1.r = 0.08
mix.drive = 0.3
amp.level = 0.596

[Fat Model Bass]
