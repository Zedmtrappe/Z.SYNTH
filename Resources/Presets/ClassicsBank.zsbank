# =============================================================================

# ------------------------------------------------------------ Minimoog ----

[Minimoog - Fat Bass]
category = Moog Minimoog
comment = Three saws, osc 3 an octave down, ladder at 24 dB, quick contour.
voice.mode = Mono
voice.priority = Low
osc1.octave = 16'
osc2.on = on
osc2.octave = 16'
osc2.fine = 6
osc3.on = on
osc3.octave = 32'
osc3.wave = Saw
osc3.fine = -4
