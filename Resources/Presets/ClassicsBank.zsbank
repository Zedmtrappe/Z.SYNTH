# ------------------------------------------------------------ Minimoog ----

[Minimoog - Fat Bass]
category = Moog Minimoog
comment = Three saws, osc 3 an octave down, ladder at 24 dB, quick contour.
voice.mode = Mono
voice.priority = Low
osc1.octave = 16'
osc2.on = on
osc2.octave = 16'
osc2.fine = 6
osc3.on = on
osc3.octave = 32'
osc3.wave = Saw
osc3.fine = -4
osc3.level = 0.7
flt.model = Ladder
flt.cutoff = 220
flt.res = 0.2
flt.env = 0.4
flt.key = 0.33
env2.d = 0.35
env2.s = 0.2
env1.s = 1
env1.r = 0.06
mix.drive = 0.5
osc.drift = 0.3
voice.vintage = 0.3
amp.level = 0.478
comp.on = on
comp.thresh = 0
out.valve.on = on
out.valve.drive = 0.5
out.xfmr.on = on
out.xfmr.amt = 0.5
tape.on = on
tape.model = Otari MTR-90
tape.speed = 30 ips
fx.rev.on = on
fx.rev.mix = 0
fx.rev.type = Bricasti M7
fx.rev.lowcut = 250

